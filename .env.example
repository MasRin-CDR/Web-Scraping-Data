# ============================================================
# .env — Mahkamah Agung Scraper
# Salin file ini ke .env dan sesuaikan nilainya
# ============================================================

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ── Database (SQLite default) ─────────────────────────────────
# Untuk SQLite, cukup tentukan path:
DB_PATH=data/mahkamah.db
# Jika ingin PostgreSQL, isi DATABASE_URL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mahkamah

# ── Scraper ───────────────────────────────────────────────────
TARGET_BASE_URL=https://putusan3.mahkamahagung.go.id
HEADLESS=true
BROWSER_TIMEOUT=30000
MIN_DELAY=2.0
MAX_DELAY=5.0
SCROLL_DELAY_MIN=0.3
SCROLL_DELAY_MAX=1.2
MAX_RETRIES=3
MAX_PAGES_PER_SEARCH=5
REQUEST_TIMEOUT=60

# ── Cache ─────────────────────────────────────────────────────
CACHE_TTL_SECONDS=3600
