# ============================================================
# Mahkamah Agung Scraper — Environment Configuration
# Copy to .env and adjust values as needed
# ============================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=*

# --- Database (SQLite) ---
DB_PATH=./data/mahkamah.db

# --- Scraper ---
TARGET_BASE_URL=https://putusan3.mahkamahagung.go.id
HEADLESS=false
BROWSER_TIMEOUT=30000
MIN_DELAY=2.0
MAX_DELAY=5.0
SCROLL_DELAY_MIN=0.3
SCROLL_DELAY_MAX=1.2
MAX_RETRIES=3
MAX_PAGES_PER_SEARCH=5
REQUEST_TIMEOUT=60

# --- Cache ---
CACHE_TTL_SECONDS=3600

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- Output ---
DATA_DIR=./data
PDF_DIR=./data/pdfs
