# ============================================================
# Mahkamah Agung Scraper — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit actual credentials to the repository!
# ============================================================

# ── APP ──────────────────────────────────────────────────────
APP_NAME=
APP_ENV=
APP_DEBUG=
APP_PORT=

# ── DATABASE ─────────────────────────────────────────────────
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── SCRAPING ─────────────────────────────────────────────────
SCRAPER_TIMEOUT=
SCRAPER_RETRY=
SCRAPER_DELAY_MIN=
SCRAPER_DELAY_MAX=

# ── PLAYWRIGHT ───────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=
PLAYWRIGHT_BROWSER=
PLAYWRIGHT_TIMEOUT=

# ── CLOUDFLARE ───────────────────────────────────────────────
ENABLE_STEALTH=
ENABLE_RANDOM_USER_AGENT=
ENABLE_PROXY_ROTATION=

# ── STORAGE ──────────────────────────────────────────────────
DOWNLOAD_PATH=
CACHE_PATH=

# ── LOGGING ──────────────────────────────────────────────────
LOG_LEVEL=
LOG_FILE=

# ── SECURITY ─────────────────────────────────────────────────
SECRET_KEY=
JWT_SECRET=
JWT_ALGORITHM=

# ── SERVER ───────────────────────────────────────────────────
HOST=
PORT=
CORS_ORIGINS=

# ── CACHE ────────────────────────────────────────────────────
CACHE_TTL_SECONDS=
